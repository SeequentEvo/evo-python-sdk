                          "less_than",
                          "less_than_or_equal_to"
                        ],
                        "title": "Operator"
                      },
                      "values": {
                        "default": null,
                        "description": "Category values to match. Required when operator is 'in' or 'not_in'. Use strings for string/category-name attributes; use integers for integer-coded attributes.",
                        "items": {
                          "description": "String category name or integer category key to match.",
                          "title": "Filter Value",
                          "type": "string"
                        },
                        "title": "Values",
                        "type": [
                          "array",
                          "null"
                        ]
                      },
                      "threshold": {
                        "default": null,
                        "description": "Numeric threshold for comparison. Required when operator is 'equal', 'not_equal', 'greater_than', 'greater_than_or_equal_to', 'less_than', or 'less_than_or_equal_to'.",
                        "title": "Threshold",
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "type": {
                        "const": "condition",
                        "description": "Identifies this as a leaf filter condition.",
                        "title": "Type"
                      },
                      "attribute": {
                        "description": "Attribute used to filter locations.",
                        "reference_to": "attribute",
                        "title": "Attribute",
                        "type": "string",
                        "attribute_from": "1/object",
                        "attribute_path": {
                          "pointset/[>=1.2,<2]": [
                            "locations.attributes[?attribute_type=='category']",
                            "locations.attributes[?attribute_type=='scalar']"
                          ],
                          "downhole-intervals/[>=1.2,<2]": [
                            "attributes[?attribute_type=='category']",
                            "attributes[?attribute_type=='scalar']"
                          ],
                          "regular-3d-grid/[>=1.2,<2]": [
                            "cell_attributes[?attribute_type=='category']",
                            "cell_attributes[?attribute_type=='scalar']"
                          ],
                          "regular-masked-3d-grid/[>=1.2,<2]": [
                            "cell_attributes[?attribute_type=='category']",
                            "cell_attributes[?attribute_type=='scalar']"
                          ],
                          "tensor-3d-grid/[>=1.2,<2]": [
                            "cell_attributes[?attribute_type=='category']",
                            "cell_attributes[?attribute_type=='scalar']"
                          ],
                          "block-model/[>=1.0,<2]": [
                            "attributes[?attribute_type=='Boolean'||attribute_type=='Utf8'||attribute_type=='Int8'||attribute_type=='Int16'||attribute_type=='Int32'||attribute_type=='Int64'||attribute_type=='UInt8'||attribute_type=='UInt16'||attribute_type=='UInt32'||attribute_type=='UInt64']",
                            "attributes[?attribute_type=='Float64']"
                          ]
                        }
                      }
                    },
                    "required": [
                      "operator",
                      "attribute"
                    ],
                    "title": "FilterCondition",
                    "type": "object"
                  },
                  {
                    "$ref": "#/$defs/AllOfFilter"
                  },
                  {
                    "$ref": "#/$defs/AnyOfFilter"
                  }
                ],
                "title": "Where"
              }
            },
            "required": [
              "where"
            ],
            "title": "Filter",
            "type": [
              "object",
              "null"
            ],
            "attribute_path": {
              "pointset/[>=1.2,<2]": [
                "locations.attributes[?attribute_type=='category']",
