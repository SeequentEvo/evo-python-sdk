{
  "display_name": "Classify by domain",
  "version": "0.1.0",
  "feature_flag": "geology-preview",
  "description": "Classifies locations from a source geometry object against an ordered list of domain entries (volumes and surfaces), writing a categorical attribute back to the source object.",
  "parameters": {
    "$defs": {
      "AllOfFilter": {
        "additionalProperties": false,
        "description": "A composite filter that passes locations satisfying ALL child filters (AND logic).",
        "properties": {
          "type": {
            "const": "all_of",
            "description": "Identifies this as an AND composite filter.",
            "title": "Type"
          },
          "filters": {
            "description": "All of these filters must be satisfied (AND logic).",
            "items": {
              "description": "A filter condition or composite filter combining multiple conditions.",
              "discriminator": "type",
              "oneOf": [
                {
                  "additionalProperties": false,
                  "description": "A leaf filter condition applied to one attribute of the filtered object.\n\nExactly one operator field must be provided.\n\n- ``in``: Membership test. Provide string category names for\n    ``CategoryAttribute`` objects or integers for integer-coded indices.\n- ``not_in``: Exclusion test.\n- ``equal``, ``not_equal``: Numeric equality/inequality.\n- ``greater_than``, ``greater_than_or_equal_to``, ``less_than``,\n    ``less_than_or_equal_to``: Numeric comparisons on numeric attributes.",
                  "properties": {
                    "operator": {
                      "description": "The filter operator. Use 'in' or 'not_in' for category/membership tests (pair with 'values'). Use 'equal', 'not_equal', 'greater_than', 'greater_than_or_equal_to', 'less_than', or 'less_than_or_equal_to' for numeric comparisons (pair with 'threshold').",
                      "enum": [
                        "in",
                        "not_in",
                        "equal",
                        "not_equal",
                        "greater_than",
                        "greater_than_or_equal_to",
                        "less_than",
                        "less_than_or_equal_to"
                      ],
                      "title": "Operator"
                    },
                    "values": {
                      "default": null,
                      "description": "Category values to match. Required when operator is 'in' or 'not_in'. Use strings for string/category-name attributes; use integers for integer-coded attributes.",
                      "items": {
                        "description": "String category name or integer category key to match.",
                        "title": "Filter Value",
                        "type": "string"
                      },
                      "title": "Values",
                      "type": [
                        "array",
                        "null"
                      ]
                    },
                    "threshold": {
                      "default": null,
                      "description": "Numeric threshold for comparison. Required when operator is 'equal', 'not_equal', 'greater_than', 'greater_than_or_equal_to', 'less_than', or 'less_than_or_equal_to'.",
                      "title": "Threshold",
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "type": {
                      "const": "condition",
                      "description": "Identifies this as a leaf filter condition.",
                      "title": "Type"
                    },
                    "attribute": {
                      "description": "Attribute used to filter locations.",
                      "reference_to": "attribute",
                      "title": "Attribute",
                      "type": "string",
                      "attribute_from": "/source/object",
                      "attribute_path": {
                        "pointset/[>=1.2,<2]": [
                          "locations.attributes[?attribute_type=='category']",
                          "locations.attributes[?attribute_type=='scalar']"
                        ],
                        "downhole-intervals/[>=1.2,<2]": [
                          "attributes[?attribute_type=='category']",
                          "attributes[?attribute_type=='scalar']"
                        ],
                        "regular-3d-grid/[>=1.2,<2]": [
                          "cell_attributes[?attribute_type=='category']",
                          "cell_attributes[?attribute_type=='scalar']"
                        ],
                        "regular-masked-3d-grid/[>=1.2,<2]": [
                          "cell_attributes[?attribute_type=='category']",
                          "cell_attributes[?attribute_type=='scalar']"
                        ],
                        "tensor-3d-grid/[>=1.2,<2]": [
                          "cell_attributes[?attribute_type=='category']",
                          "cell_attributes[?attribute_type=='scalar']"
                        ],
                        "block-model/[>=1.0,<2]": [
                          "attributes[?attribute_type=='Boolean'||attribute_type=='Utf8'||attribute_type=='Int8'||attribute_type=='Int16'||attribute_type=='Int32'||attribute_type=='Int64'||attribute_type=='UInt8'||attribute_type=='UInt16'||attribute_type=='UInt32'||attribute_type=='UInt64']",
                          "attributes[?attribute_type=='Float64']"
                        ]
                      }
                    }
                  },
                  "required": [
                    "operator",
                    "attribute"
                  ],
                  "title": "FilterCondition",
                  "type": "object"
                },
                {
                  "$ref": "#/$defs/AllOfFilter"
                },
                {
                  "$ref": "#/$defs/AnyOfFilter"
                }
              ],
              "title": "Filter Expression"
            },
            "title": "Filters",
            "type": "array"
          }
        },
        "required": [
          "filters"
        ],
        "title": "AllOfFilter",
        "type": "object"
      },
      "AnyOfFilter": {
        "additionalProperties": false,
        "description": "A composite filter that passes locations satisfying ANY child filter (OR logic).",
        "properties": {
          "type": {
            "const": "any_of",
            "description": "Identifies this as an OR composite filter.",
            "title": "Type"
          },
          "filters": {
            "description": "At least one of these filters must be satisfied (OR logic).",
            "items": {
              "description": "A filter condition or composite filter combining multiple conditions.",
              "discriminator": "type",
              "oneOf": [
                {
                  "additionalProperties": false,
                  "description": "A leaf filter condition applied to one attribute of the filtered object.\n\nExactly one operator field must be provided.\n\n- ``in``: Membership test. Provide string category names for\n    ``CategoryAttribute`` objects or integers for integer-coded indices.\n- ``not_in``: Exclusion test.\n- ``equal``, ``not_equal``: Numeric equality/inequality.\n- ``greater_than``, ``greater_than_or_equal_to``, ``less_than``,\n    ``less_than_or_equal_to``: Numeric comparisons on numeric attributes.",
                  "properties": {
                    "operator": {
                      "description": "The filter operator. Use 'in' or 'not_in' for category/membership tests (pair with 'values'). Use 'equal', 'not_equal', 'greater_than', 'greater_than_or_equal_to', 'less_than', or 'less_than_or_equal_to' for numeric comparisons (pair with 'threshold').",
                      "enum": [
                        "in",
                        "not_in",
                        "equal",
                        "not_equal",
                        "greater_than",
                        "greater_than_or_equal_to",
                        "less_than",
                        "less_than_or_equal_to"
                      ],
                      "title": "Operator"
                    },
                    "values": {
                      "default": null,
                      "description": "Category values to match. Required when operator is 'in' or 'not_in'. Use strings for string/category-name attributes; use integers for integer-coded attributes.",
                      "items": {
                        "description": "String category name or integer category key to match.",
                        "title": "Filter Value",
                        "type": "string"
                      },
                      "title": "Values",
                      "type": [
                        "array",
                        "null"
                      ]
                    },
                    "threshold": {
                      "default": null,
                      "description": "Numeric threshold for comparison. Required when operator is 'equal', 'not_equal', 'greater_than', 'greater_than_or_equal_to', 'less_than', or 'less_than_or_equal_to'.",
                      "title": "Threshold",
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "type": {
                      "const": "condition",
                      "description": "Identifies this as a leaf filter condition.",
                      "title": "Type"
                    },
                    "attribute": {
                      "description": "Attribute used to filter locations.",
                      "reference_to": "attribute",
                      "title": "Attribute",
                      "type": "string",
                      "attribute_from": "/source/object",
                      "attribute_path": {
                        "pointset/[>=1.2,<2]": [
                          "locations.attributes[?attribute_type=='category']",
                          "locations.attributes[?attribute_type=='scalar']"
                        ],
                        "downhole-intervals/[>=1.2,<2]": [
                          "attributes[?attribute_type=='category']",
                          "attributes[?attribute_type=='scalar']"
                        ],
                        "regular-3d-grid/[>=1.2,<2]": [
                          "cell_attributes[?attribute_type=='category']",
                          "cell_attributes[?attribute_type=='scalar']"
                        ],
                        "regular-masked-3d-grid/[>=1.2,<2]": [
                          "cell_attributes[?attribute_type=='category']",
                          "cell_attributes[?attribute_type=='scalar']"
                        ],
                        "tensor-3d-grid/[>=1.2,<2]": [
                          "cell_attributes[?attribute_type=='category']",
                          "cell_attributes[?attribute_type=='scalar']"
                        ],
                        "block-model/[>=1.0,<2]": [
                          "attributes[?attribute_type=='Boolean'||attribute_type=='Utf8'||attribute_type=='Int8'||attribute_type=='Int16'||attribute_type=='Int32'||attribute_type=='Int64'||attribute_type=='UInt8'||attribute_type=='UInt16'||attribute_type=='UInt32'||attribute_type=='UInt64']",
                          "attributes[?attribute_type=='Float64']"
                        ]
                      }
                    }
                  },
                  "required": [
                    "operator",
                    "attribute"
                  ],
                  "title": "FilterCondition",
                  "type": "object"
                },
                {
                  "$ref": "#/$defs/AllOfFilter"
                },
                {
                  "$ref": "#/$defs/AnyOfFilter"
                }
              ],
              "title": "Filter Expression"
            },
            "title": "Filters",
            "type": "array"
          }
        },
        "required": [
          "filters"
        ],
        "title": "AnyOfFilter",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "Parameters for the classify-by-domain task.",
    "properties": {
      "source": {
        "additionalProperties": false,
        "description": "Source geometry object whose locations will be classified.",
        "properties": {
          "object": {
            "format": "uri",
            "reference_to": "geoscience-object",
            "supported_schemas": [
              "pointset/[>=1.2,<2]",
              "block-model/[>=1.0,<2]",
              "regular-3d-grid/[>=1.2,<2]",
              "regular-masked-3d-grid/[>=1.2,<2]",
              "tensor-3d-grid/[>=1.2,<2]",
              "downhole-intervals/[>=1.2,<2]"
            ],
            "type": "string",
            "description": "The source geometry object whose locations will be classified. Supports pointsets, block models, regular 3D grids, masked 3D grids, tensor 3D grids, and downhole intervals (midpoints).",
            "title": "Object"
          },
          "filter": {
            "additionalProperties": false,
            "attribute_from": "1/object",
            "composite": "filter",
            "default": null,
            "description": "Optional filter to restrict which locations are classified. Filtered-out locations are written as null in the output attribute.",
            "properties": {
              "where": {
                "description": "A filter expression defining which locations to include. Use a FilterCondition for a single predicate, AllOfFilter for AND logic, AnyOfFilter for OR logic, or nest them to build compound predicates.",
                "discriminator": "type",
                "oneOf": [
                  {
                    "additionalProperties": false,
                    "description": "A leaf filter condition applied to one attribute of the filtered object.\n\nExactly one operator field must be provided.\n\n- ``in``: Membership test. Provide string category names for\n    ``CategoryAttribute`` objects or integers for integer-coded indices.\n- ``not_in``: Exclusion test.\n- ``equal``, ``not_equal``: Numeric equality/inequality.\n- ``greater_than``, ``greater_than_or_equal_to``, ``less_than``,\n    ``less_than_or_equal_to``: Numeric comparisons on numeric attributes.",
                    "properties": {
                      "operator": {
                        "description": "The filter operator. Use 'in' or 'not_in' for category/membership tests (pair with 'values'). Use 'equal', 'not_equal', 'greater_than', 'greater_than_or_equal_to', 'less_than', or 'less_than_or_equal_to' for numeric comparisons (pair with 'threshold').",
                        "enum": [
