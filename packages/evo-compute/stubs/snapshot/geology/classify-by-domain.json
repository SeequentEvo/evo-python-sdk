      "domain_entries": {
        "description": "Ordered list of domain entries defining the classification hierarchy. Locations are evaluated against entries in order; the first matching entry wins. Each entry is either a VolumeEntry (inside/outside a closed mesh) or a SurfaceEntry (above/below an open mesh surface).",
        "items": {
          "description": "A single domain entry defining a mesh object, spatial relationship, and the category label to assign.",
          "discriminator": "type",
          "oneOf": [
            {
              "additionalProperties": false,
              "description": "A domain entry that classifies locations as inside or outside a closed mesh volume.",
              "properties": {
                "type": {
                  "const": "volume",
                  "description": "Discriminator identifying this as a volume (inside/outside) entry.",
                  "title": "Type"
                },
                "domain": {
                  "discriminator": "type",
                  "oneOf": [
                    {
                      "additionalProperties": false,
                      "description": "A standalone triangle mesh domain.",
                      "properties": {
                        "type": {
                          "const": "mesh",
                          "description": "Discriminator identifying a standalone triangle mesh domain.",
                          "title": "Type"
                        },
                        "object": {
                          "description": "Standalone triangle mesh used as the domain.",
                          "format": "uri",
                          "reference_to": "geoscience-object",
                          "supported_schemas": [
                            "triangle-mesh/[>=2.0,<3]"
                          ],
                          "title": "Triangle Mesh Object",
                          "type": "string"
                        }
                      },
                      "required": [
                        "type",
                        "object"
                      ],
                      "title": "MeshDomainObject",
                      "type": "object"
                    },
                    {
                      "additionalProperties": false,
                      "description": "A named volume or surface within a geological-model-meshes object.",
                      "properties": {
                        "type": {
                          "const": "gmm",
                          "description": "Discriminator identifying a geological-model-meshes domain.",
                          "title": "Type"
                        },
                        "object": {
                          "description": "Object containing the named domain.",
                          "format": "uri",
                          "reference_to": "geoscience-object",
                          "supported_schemas": [
                            "geological-model-meshes/[>=2.0,<3]"
                          ],
                          "title": "Geological Model Meshes Object",
                          "type": "string"
                        },
                        "name": {
                          "description": "Name of the volume or surface within the geological-model-meshes object.",
                          "title": "Name",
                          "type": "string"
                        }
                      },
                      "required": [
                        "type",
                        "object",
                        "name"
                      ],
                      "title": "GMMDomainObject",
                      "type": "object"
                    }
                  ],
                  "description": "A closed triangle mesh, or a named volume within a geological-model-meshes object. When a triangle mesh is provided it must be closed; otherwise an error is raised at runtime.",
                  "title": "Domain"
                },
                "relationship": {
                  "description": "Spatial relationship: 'inside' matches locations enclosed by the volume; 'outside' matches the rest.",
                  "enum": [
                    "inside",
                    "outside"
                  ],
                  "title": "Relationship"
                },
                "category": {
                  "description": "Category label assigned to locations matching this entry.",
                  "title": "Category",
                  "type": "string"
                }
              },
              "required": [
                "type",
                "domain",
                "relationship",
                "category"
              ],
              "title": "VolumeEntry",
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "A domain entry that classifies locations as above or below an open mesh surface.",
              "properties": {
                "type": {
                  "const": "surface",
                  "description": "Discriminator identifying this as a surface (above/below) entry.",
                  "title": "Type"
                },
                "domain": {
                  "discriminator": "type",
                  "oneOf": [
                    {
                      "additionalProperties": false,
                      "description": "A standalone triangle mesh domain.",
                      "properties": {
                        "type": {
                          "const": "mesh",
                          "description": "Discriminator identifying a standalone triangle mesh domain.",
                          "title": "Type"
                        },
                        "object": {
                          "description": "Standalone triangle mesh used as the domain.",
                          "format": "uri",
                          "reference_to": "geoscience-object",
                          "supported_schemas": [
                            "triangle-mesh/[>=2.0,<3]"
                          ],
                          "title": "Triangle Mesh Object",
                          "type": "string"
                        }
                      },
                      "required": [
                        "type",
                        "object"
                      ],
                      "title": "MeshDomainObject",
                      "type": "object"
                    },
                    {
                      "additionalProperties": false,
                      "description": "A named volume or surface within a geological-model-meshes object.",
                      "properties": {
                        "type": {
                          "const": "gmm",
                          "description": "Discriminator identifying a geological-model-meshes domain.",
                          "title": "Type"
                        },
                        "object": {
                          "description": "Object containing the named domain.",
                          "format": "uri",
                          "reference_to": "geoscience-object",
                          "supported_schemas": [
                            "geological-model-meshes/[>=2.0,<3]"
                          ],
                          "title": "Geological Model Meshes Object",
                          "type": "string"
                        },
                        "name": {
                          "description": "Name of the volume or surface within the geological-model-meshes object.",
                          "title": "Name",
                          "type": "string"
                        }
                      },
                      "required": [
                        "type",
                        "object",
                        "name"
                      ],
                      "title": "GMMDomainObject",
                      "type": "object"
                    }
                  ],
                  "description": "An open triangle mesh surface, or a named surface within a geological-model-meshes object. When a triangle mesh is provided it must NOT be closed; otherwise an error is raised at runtime.",
                  "title": "Domain"
                },
                "relationship": {
                  "description": "Spatial relationship: 'above' matches locations with a positive Z distance to the surface; 'below' matches the other side.",
                  "enum": [
                    "above",
                    "below"
                  ],
                  "title": "Relationship"
                },
                "category": {
                  "description": "Category label assigned to locations matching this entry.",
                  "title": "Category",
                  "type": "string"
                }
              },
              "required": [
                "type",
                "domain",
                "relationship",
                "category"
              ],
              "title": "SurfaceEntry",
              "type": "object"
            }
          ],
          "title": "Domain Entry"
        },
        "minItems": 1,
        "title": "Domain Entries",
        "type": "array"
      },
