{
  "display_name": "SHP Import",
  "version": "0.1.41",
  "feature_flag": "converter-preview",
  "description": "Task to import SHP files into Evo as Triangle Mesh geoscience objects.",
  "parameters": {
    "additionalProperties": false,
    "description": "Parameters for the SHP import compute task.",
    "properties": {
      "file": {
        "description": "SHP file to import.",
        "file_extensions": [
          ".shp"
        ],
        "format": "uri",
        "reference_to": "file",
        "title": "Input File",
        "type": "string"
      },
      "file_shx": {
        "description": "SHX spatial index file (required companion to the .shp file).",
        "file_extensions": [
          ".shx"
        ],
        "format": "uri",
        "reference_to": "file",
        "title": "Input SHX File",
        "type": "string"
      },
      "file_dbf": {
        "description": "DBF attribute file (required companion to the .shp file).",
        "file_extensions": [
          ".dbf"
        ],
        "format": "uri",
        "reference_to": "file",
        "title": "Input DBF File",
        "type": "string"
      },
      "file_prj": {
        "default": null,
        "description": "Optional PRJ projection file.",
        "file_extensions": [
          ".prj"
        ],
        "format": "uri",
        "reference_to": "file",
        "title": "Input PRJ File",
        "type": [
          "string",
          "null"
        ]
      },
      "file_cpg": {
        "default": null,
        "description": "Optional CPG code page file for character encoding.",
        "file_extensions": [
          ".cpg"
        ],
        "format": "uri",
        "reference_to": "file",
        "title": "Input CPG File",
        "type": [
          "string",
          "null"
        ]
      },
      "file_sbn": {
        "default": null,
        "description": "Optional SBN spatial index file (not currently used).",
        "file_extensions": [
          ".sbn"
        ],
        "format": "uri",
        "reference_to": "file",
        "title": "Input SBN File",
        "type": [
          "string",
          "null"
        ]
      },
      "file_sbx": {
        "default": null,
        "description": "Optional SBX spatial index file (not currently used).",
        "file_extensions": [
          ".sbx"
        ],
        "format": "uri",
        "reference_to": "file",
        "title": "Input SBX File",
        "type": [
          "string",
          "null"
        ]
      },
      "file_xml": {
        "default": null,
        "description": "Optional XML metadata file (not currently used).",
        "file_extensions": [
          ".xml"
        ],
        "format": "uri",
        "reference_to": "file",
        "title": "Input XML File",
        "type": [
          "string",
          "null"
        ]
      },
      "target": {
        "additionalProperties": false,
        "description": "Target specifying where to create or update the imported geoscience object. Contains 'reference' (File API URL) and optional 'overwrite' (boolean, only valid for path references).",
        "properties": {
          "reference": {
            "description": "Reference to the targeted object.",
            "format": "uri",
            "reference_to": "geoscience-object",
            "supported_schemas": [
              "triangle-mesh/[>=2.0,<3]",
              "line-segments/[>=2.1,<3]",
              "pointset/[>=1.2,<2]"
            ],
            "title": "Reference",
            "type": "string"
          },
          "overwrite": {
            "default": false,
            "description": "Whether to overwrite the existing object.",
            "title": "Overwrite",
            "type": "boolean"
          },
          "description": {
            "default": null,
            "description": "Description to put into the target object.",
            "title": "Description",
            "type": [
              "string",
              "null"
            ]
          },
          "tags": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Tags to put into the target object.",
            "title": "Tags",
            "type": "object"
          }
        },
        "required": [
          "reference"
        ],
        "target": "geoscience-object",
        "title": "Target",
        "type": "object"
      }
    },
    "required": [
      "file",
      "file_shx",
      "file_dbf",
      "target"
    ],
    "title": "SHPImportParameters",
    "type": "object"
  },
  "results": {
    "additionalProperties": false,
    "description": "Results for the SHP import compute task.",
    "properties": {
      "object": {
        "additionalProperties": false,
        "output": "geoscience-object",
        "properties": {
          "reference": {
            "description": "Reference to a geoscience object.",
            "format": "uri",
            "reference_to": "geoscience-object",
            "supported_schemas": [
              "triangle-mesh/[>=2.0,<3]",
              "line-segments/[>=2.1,<3]",
              "pointset/[>=1.2,<2]"
            ],
            "title": "Reference",
            "type": "string"
          },
          "name": {
            "description": "The name of the geoscience object.",
            "title": "Name",
            "type": "string"
          },
          "description": {
            "description": "The description of the geoscience object.",
            "title": "Description",
            "type": [
              "string",
              "null"
            ]
          },
          "schema_id": {
            "description": "The ID of the Geoscience Object schema.",
            "title": "Schema ID",
            "type": "string"
          }
        },
        "required": [
          "reference",
          "name",
          "description",
          "schema_id"
        ],
        "type": "object",
        "description": "The geoscience object created from the input file(s).",
        "title": "Output Geoscience Object"
      }
    },
    "required": [
      "object"
    ],
    "title": "SHPImportResults",
    "type": "object"
  }
}
