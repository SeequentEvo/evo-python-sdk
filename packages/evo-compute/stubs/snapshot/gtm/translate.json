          "description": "A geoscience object to process.",
          "format": "uri",
          "reference_to": "geoscience-object",
          "supported_schemas": [
            "triangle-mesh/[>=2.0,<3]"
          ],
          "title": "Input Object",
          "type": "string"
        },
        "minItems": 1,
        "title": "Input Objects",
        "type": "array"
      },
      "sessionId": {
        "description": "The session identifier",
        "title": "Session ID",
        "type": "string"
      }
    },
    "required": [
      "gooseContext",
      "action",
      "inputObjects",
      "delta"
