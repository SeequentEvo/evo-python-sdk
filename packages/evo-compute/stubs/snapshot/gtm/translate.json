        "title": "Action"
      },
      "delta": {
        "additionalProperties": false,
        "description": "[TODO: Add description for delta]",
        "properties": {
          "x": {
            "description": "X coordinate of the delta",
            "title": "X",
            "type": "number"
          },
          "y": {
            "description": "Y coordinate of the delta",
            "title": "Y",
            "type": "number"
          },
          "z": {
            "description": "Z coordinate of the delta",
            "title": "Z",
            "type": "number"
          }
        },
        "required": [
          "x",
          "y",
          "z"
        ],
        "title": "Delta",
        "type": "object"
      },
      "gooseContext": {
        "additionalProperties": false,
        "description": "Context information for the Goose API",
        "properties": {
          "apiToken": {
            "description": "Authentication token for the API",
            "title": "API Token",
            "type": "string"
          },
          "host": {
            "description": "The hostname for the API",
            "title": "Host",
            "type": "string"
          },
          "hubUrl": {
            "description": "Hub URL currently being used",
            "title": "Hub URL",
            "type": "string"
          },
          "workspaceId": {
            "description": "The workspace identifier",
            "format": "uuid",
            "title": "Workspace ID",
            "type": "string"
          }
        },
        "required": [
          "host",
          "apiToken",
          "workspaceId"
        ],
        "title": "Goose Context",
        "type": "object"
