{
  "display_name": "Translate",
  "version": "0.0.1",
  "feature_flag": "",
  "description": "[TODO: Add description] Performs Translate operation on geotechnical objects.",
  "parameters": {
    "additionalProperties": false,
    "description": "Parameters for this task.",
    "properties": {
      "action": {
        "const": "translate",
