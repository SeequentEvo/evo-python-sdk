{
  "display_name": "Make GMM Into Intersected Geometry",
  "version": "0.0.1",
  "feature_flag": "",
  "description": "Prepares a Geological Model Meshes object to be used as an Intersected Geometry. This involves removing all open surfaces, translating to origin, collapsing overlapping triangles into shared triangles, and clipping the geometry to the given bounds.",
  "parameters": {
    "additionalProperties": false,
    "description": "Parameters for this task.",
    "properties": {
      "action": {
        "const": "make-gmm-into-intersected-geometry",
        "description": "The action to perform",
        "title": "Action"
      },
      "attemptConformalization": {
        "default": false,
        "description": "Whether to attempt making the GMM conformal before processing.",
        "title": "Attempt Conformalization",
        "type": "boolean"
      },
      "clipTolerance": {
        "description": "Distance tolerance used when clipping the mesh by the bounding box.",
        "title": "Clip Tolerance",
        "type": "number"
      },
      "collapseDistanceTolerance": {
        "description": "Distance tolerance used when collapsing overlapping triangles.",
        "title": "Collapse Distance Tolerance",
        "type": "number"
      },
      "collapseOverlapThreshold": {
        "description": "Overlap ratio threshold that triggers triangle collapse.",
        "title": "Collapse Overlap Threshold",
        "type": "number"
      },
      "gooseContext": {
        "additionalProperties": false,
        "description": "Context information for the Goose API",
        "properties": {
          "apiToken": {
            "description": "Authentication token for the API",
            "title": "API Token",
            "type": "string"
          },
          "host": {
            "description": "The hostname for the API",
            "title": "Host",
            "type": "string"
          },
          "hubUrl": {
            "description": "Hub URL currently being used",
            "title": "Hub URL",
            "type": "string"
          },
          "workspaceId": {
            "description": "The workspace identifier",
            "format": "uuid",
            "title": "Workspace ID",
            "type": "string"
          }
        },
        "required": [
          "host",
          "apiToken",
          "workspaceId"
        ],
        "title": "Goose Context",
        "type": "object"
      },
      "inputObjects": {
        "description": "The geoscience objects to process.",
        "items": {
          "description": "A geoscience object to process.",
          "format": "uri",
          "reference_to": "geoscience-object",
          "supported_schemas": [
            "geological-model-meshes/[>=2.0,<3]"
          ],
          "title": "Input Object",
          "type": "string"
        },
        "maxItems": 1,
        "minItems": 1,
        "title": "Input Objects",
        "type": "array"
      },
      "maxPoint": {
        "additionalProperties": false,
        "description": "Upper corner of the clipping bounding box.",
        "properties": {
          "x": {
            "description": "X coordinate of the bounds maximum point for clipping",
            "title": "X",
            "type": "number"
          },
          "y": {
            "description": "Y coordinate of the bounds maximum point for clipping",
            "title": "Y",
            "type": "number"
          },
          "z": {
            "description": "Z coordinate of the bounds maximum point for clipping",
            "title": "Z",
            "type": "number"
          }
        },
        "required": [
          "x",
          "y",
          "z"
        ],
        "title": "Clipping Max Point",
        "type": "object"
      },
      "minPoint": {
        "additionalProperties": false,
        "description": "Lower corner of the clipping bounding box.",
        "properties": {
          "x": {
            "description": "X coordinate of the bounds minimum point for clipping",
            "title": "X",
            "type": "number"
          },
          "y": {
            "description": "Y coordinate of the bounds minimum point for clipping",
            "title": "Y",
            "type": "number"
          },
          "z": {
            "description": "Z coordinate of the bounds minimum point for clipping",
            "title": "Z",
            "type": "number"
          }
        },
        "required": [
          "x",
          "y",
          "z"
        ],
        "title": "Clipping Min Point",
        "type": "object"
      },
      "path": {
        "description": "[TODO: Add description for path]",
        "title": "Path",
        "type": "string"
      },
      "rotationAngle": {
        "description": "Rotation, in degrees, applied to the clipping bounding box.",
        "title": "Rotation Angle",
        "type": "number"
      },
      "sessionId": {
        "description": "The session identifier",
        "title": "Session ID",
        "type": "string"
      }
    },
    "required": [
      "gooseContext",
      "action",
      "inputObjects",
      "path",
      "minPoint",
      "maxPoint",
      "rotationAngle"
    ],
    "title": "Parameters",
    "type": "object"
  },
  "results": {
    "additionalProperties": false,
    "description": "Results of the task.",
    "properties": {
      "created": {
        "description": "Array of created object references",
        "items": {
          "description": "Reference to a geoscience object",
          "format": "uri",
          "reference_to": "geoscience-object",
          "supported_schemas": [
            "geological-model-meshes/[>=2.1,<3]"
          ],
          "title": "Object Reference",
          "type": "string"
        },
        "title": "Created Objects",
        "type": "array"
      },
      "deleted": {
        "description": "Array of deleted object references",
        "items": {
          "description": "Reference to a geoscience object",
          "format": "uri",
          "reference_to": "geoscience-object",
          "supported_schemas": [
            "geological-model-meshes/[>=2.1,<3]"
          ],
          "title": "Object Reference",
          "type": "string"
        },
        "title": "Deleted Objects",
        "type": "array"
      },
      "modified": {
        "description": "Array of modified object references",
        "items": {
          "description": "Reference to a geoscience object",
          "format": "uri",
          "reference_to": "geoscience-object",
          "supported_schemas": [
            "geological-model-meshes/[>=2.1,<3]"
          ],
          "title": "Object Reference",
          "type": "string"
        },
        "title": "Modified Objects",
        "type": "array"
      }
    },
    "required": [
      "modified",
      "created",
      "deleted"
    ],
    "title": "Results",
    "type": "object"
  }
}
