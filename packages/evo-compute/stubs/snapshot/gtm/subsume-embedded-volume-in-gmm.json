{
  "display_name": "Subsume Embedded Volume in a `geological-model-meshes` object.",
  "version": "0.0.1",
  "feature_flag": "",
  "description": "Subsume an embedded volume of a `geological-model-meshes` object into a neighbouring embedded volume. ",
  "parameters": {
    "additionalProperties": false,
    "description": "Parameters for this task.",
    "properties": {
      "action": {
        "const": "subsume-embedded-volume-in-gmm",
        "description": "The action to perform",
        "title": "Action"
      },
      "gooseContext": {
        "additionalProperties": false,
        "description": "Context information for the Goose API",
        "properties": {
          "apiToken": {
            "description": "Authentication token for the API",
            "title": "API Token",
            "type": "string"
          },
          "host": {
            "description": "The hostname for the API",
            "title": "Host",
            "type": "string"
          },
          "hubUrl": {
            "description": "Hub URL currently being used",
            "title": "Hub URL",
            "type": "string"
          },
          "workspaceId": {
            "description": "The workspace identifier",
            "format": "uuid",
            "title": "Workspace ID",
            "type": "string"
          }
        },
        "required": [
          "host",
          "apiToken",
          "workspaceId"
        ],
        "title": "Goose Context",
        "type": "object"
      },
      "inputObjects": {
        "description": "The geological-model-meshes object to process.",
        "items": {
          "description": "A geological-model-meshes object to process.",
          "format": "uri",
          "reference_to": "geoscience-object",
          "supported_schemas": [
            "geological-model-meshes/[>=2.1,<3]"
          ],
          "title": "Input Object",
          "type": "string"
        },
        "maxItems": 1,
        "minItems": 1,
        "title": "Input Objects",
        "type": "array"
      },
      "sessionId": {
        "description": "The session identifier",
        "title": "Session ID",
        "type": "string"
      },
      "subsumeSource": {
        "description": "Index of the embedded volume to subsume.",
        "minimum": 0,
        "title": "Embedded Volume to Subsume.",
        "type": "integer"
      },
      "subsumeTarget": {
        "description": "Either supply a target embedding index to subsume into, or select a selection strategy.",
        "discriminator": "type",
        "oneOf": [
          {
            "additionalProperties": false,
            "description": "Provide a specific embedded volume index to subsume into.",
            "properties": {
              "subsumeByIndex": {
                "description": "Index of the embedded volume to subsume into.",
                "minimum": 0,
                "title": "Subsume Target Index",
                "type": "integer"
              },
              "type": {
                "const": "subsumeByIndex",
                "description": "Indicates that a specific target index is being provided.",
                "title": "Type"
              }
            },
            "required": [
              "type",
              "subsumeByIndex"
            ],
            "title": "Subsume by Embedding Index",
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "Choose a strategy to automatically select the target embedding.",
            "properties": {
              "subsumeAutomaticallyByStrategy": {
                "default": "LargestNeighbouringVolume",
                "description": "Strategy to automatically select the target volume.",
                "enum": [
                  "LargestNeighbouringVolume",
                  "LargestNeighbouringContactArea"
                ],
                "title": "Subsume Target Strategy"
              },
              "type": {
                "const": "subsumeAutomaticallyByStrategy",
                "description": "Indicates that a selection strategy is being provided.",
                "title": "Type"
              }
            },
            "required": [
              "type",
              "subsumeAutomaticallyByStrategy"
            ],
            "title": "Subsume by Automatic Selection Strategy",
            "type": "object"
          }
        ],
        "title": "Subsume Method"
      }
    },
    "required": [
      "gooseContext",
      "action",
      "inputObjects",
      "subsumeSource"
    ],
    "title": "Parameters",
    "type": "object"
  },
  "results": {
    "additionalProperties": false,
    "description": "Results of the task.",
    "properties": {
      "created": {
        "description": "Array of created object references",
        "items": {
          "description": "Reference to a geoscience object",
          "format": "uri",
          "reference_to": "geoscience-object",
          "supported_schemas": [
            "geological-model-meshes/[>=2.1,<3]"
          ],
          "title": "Object Reference",
          "type": "string"
        },
        "title": "Created Objects",
        "type": "array"
      },
      "deleted": {
        "description": "Array of deleted object references",
        "items": {
          "description": "Reference to a geoscience object",
          "format": "uri",
          "reference_to": "geoscience-object",
          "supported_schemas": [
            "geological-model-meshes/[>=2.1,<3]"
          ],
          "title": "Object Reference",
          "type": "string"
        },
        "title": "Deleted Objects",
        "type": "array"
      },
      "modified": {
        "description": "Array of modified object references",
        "items": {
          "description": "Reference to a geoscience object",
          "format": "uri",
          "reference_to": "geoscience-object",
          "supported_schemas": [
            "geological-model-meshes/[>=2.1,<3]"
          ],
          "title": "Object Reference",
          "type": "string"
        },
        "title": "Modified Objects",
        "type": "array"
      }
    },
    "required": [
      "modified",
      "created",
      "deleted"
    ],
    "title": "Results",
    "type": "object"
  }
}
