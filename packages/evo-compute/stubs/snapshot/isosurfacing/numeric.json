{
  "display_name": "Numeric",
  "version": "0.1.4",
  "feature_flag": "isosurfacing-preview",
  "description": "Generate an isosurface at a specified threshold value from numeric attributes on 3D grids. Supports regular, tensor, masked, block model, and unstructured hexahedral and tetrahedral grids.",
  "parameters": {
    "additionalProperties": false,
    "description": "Parameters for the isosurfacing-numeric task.",
    "properties": {
      "settings": {
        "additionalProperties": false,
        "description": "Optional settings for isosurface generation",
        "properties": {
          "cluster_vertices": {
            "default": false,
            "description": "Merge close vertices on intersected edges to improve surface quality (structured grids only)",
            "title": "Cluster Vertices",
            "type": "boolean"
          },
          "flip_triangles": {
            "default": false,
            "description": "Reverse triangle winding order (flip normals)",
            "title": "Flip Triangles",
            "type": "boolean"
          }
        },
        "required": [],
        "title": "NumericSettings",
        "type": "object"
      },
      "source": {
        "additionalProperties": false,
        "description": "Source grid and attribute",
        "properties": {
          "attribute": {
            "attribute_from": "1/object",
            "attribute_path": {
              "block-model/[>=1.0,<2]": [
                "attributes[?attribute_type=='Float64']"
              ],
              "regular-3d-grid/[>=1.2,<2]": [
                "cell_attributes[?attribute_type=='scalar']",
                "vertex_attributes[?attribute_type=='scalar']"
              ],
              "regular-masked-3d-grid/[>=1.2,<2]": [
                "cell_attributes[?attribute_type=='scalar']"
              ],
              "tensor-3d-grid/[>=1.2,<2]": [
                "cell_attributes[?attribute_type=='scalar']",
                "vertex_attributes[?attribute_type=='scalar']"
              ],
              "unstructured-hex-grid/[>=1.2,<2]": [
                "hexahedrons.vertices.attributes[?attribute_type=='scalar']"
              ],
              "unstructured-tet-grid/[>=1.2,<2]": [
                "tetrahedra.vertices.attributes[?attribute_type=='scalar']"
              ]
            },
            "description": "Numeric attribute to generate isosurface from",
            "reference_to": "attribute",
            "title": "Attribute",
            "type": "string"
          },
          "object": {
            "description": "Input grid containing the numeric attribute to generate isosurface from",
            "format": "uri",
            "reference_to": "geoscience-object",
            "supported_schemas": [
              "block-model/[>=1.0,<2]",
              "regular-3d-grid/[>=1.2,<2]",
              "regular-masked-3d-grid/[>=1.2,<2]",
              "tensor-3d-grid/[>=1.2,<2]",
              "unstructured-hex-grid/[>=1.2,<2]",
              "unstructured-tet-grid/[>=1.2,<2]"
            ],
            "title": "Object",
            "type": "string"
          }
        },
        "required": [
          "object",
          "attribute"
        ],
        "title": "NumericSourceInput",
        "type": "object"
      },
      "target": {
        "additionalProperties": false,
        "description": "Where to create the output Triangle Mesh object",
        "properties": {
          "description": {
            "default": null,
            "description": "Description to put into the target object.",
            "title": "Description",
            "type": [
              "string",
              "null"
            ]
          },
          "overwrite": {
            "default": false,
            "description": "Whether to overwrite the existing object.",
            "title": "Overwrite",
            "type": "boolean"
          },
          "reference": {
            "description": "Reference to the targeted object.",
            "format": "uri",
            "reference_to": "geoscience-object",
            "supported_schemas": [
              "triangle-mesh/[>=2.0,<3]"
            ],
            "title": "Reference",
            "type": "string"
          },
          "tags": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Tags to put into the target object.",
            "title": "Tags",
            "type": "object"
          }
        },
        "required": [
          "reference"
        ],
        "target": "geoscience-object",
        "title": "Target",
        "type": "object"
      },
      "threshold": {
        "description": "Threshold value at which to extract the isosurface",
        "title": "Threshold",
        "type": "number"
      }
    },
    "required": [
      "source",
      "threshold",
      "target"
    ],
    "title": "NumericParameters",
    "type": "object"
  },
  "results": {
    "additionalProperties": false,
    "description": "Results of the isosurfacing-numeric task.",
    "properties": {
      "output": {
        "additionalProperties": false,
        "description": "Reference to the created Triangle Mesh object",
        "output": "geoscience-object",
        "properties": {
          "description": {
            "description": "The description of the geoscience object.",
            "title": "Description",
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "description": "The name of the geoscience object.",
            "title": "Name",
            "type": "string"
          },
          "reference": {
            "description": "Reference to a geoscience object.",
            "format": "uri",
            "reference_to": "geoscience-object",
            "supported_schemas": [
              "triangle-mesh/[>=2.0,<3]"
            ],
            "title": "Reference",
            "type": "string"
          },
          "schema_id": {
            "description": "The ID of the Geoscience Object schema.",
            "title": "Schema ID",
            "type": "string"
          }
        },
        "required": [
          "reference",
          "name",
          "description",
          "schema_id"
        ],
        "title": "Output Triangle Mesh",
        "type": "object"
      },
      "summary": {
        "additionalProperties": false,
        "description": "Summary statistics for the generated isosurface",
        "properties": {
          "has_non_manifold_edges": {
            "description": "Whether the mesh has non-manifold edges (quality check)",
            "title": "Has Non Manifold Edges",
            "type": "boolean"
          },
          "has_unused_vertices": {
            "description": "Whether the mesh has orphan vertices (quality check)",
            "title": "Has Unused Vertices",
            "type": "boolean"
          },
          "num_triangles": {
            "description": "Number of triangles in the generated surface",
            "title": "Num Triangles",
            "type": "integer"
          },
          "num_vertices": {
            "description": "Number of unique vertices in the mesh",
            "title": "Num Vertices",
            "type": "integer"
          },
          "threshold": {
            "description": "The threshold value used",
            "title": "Threshold",
            "type": "number"
          }
        },
        "required": [
          "num_triangles",
          "num_vertices",
          "threshold",
          "has_unused_vertices",
          "has_non_manifold_edges"
        ],
        "title": "NumericSummary",
        "type": "object"
      }
    },
    "required": [
      "output",
      "summary"
    ],
    "title": "NumericResults",
    "type": "object"
  }
}
