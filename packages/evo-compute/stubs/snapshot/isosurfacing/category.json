{
  "display_name": "Category",
  "version": "0.1.4",
  "feature_flag": "isosurfacing-preview",
  "description": "Generate closed volume meshes or boundary surfaces from category attributes on 3D grids. Supports single-category extraction.",
  "parameters": {
    "additionalProperties": false,
    "description": "Parameters for the category isosurface task.",
    "properties": {
      "category": {
        "description": "Category value to extract as a closed volume surface",
        "title": "Category",
        "type": "string"
      },
      "settings": {
        "additionalProperties": false,
        "description": "Optional settings for surface generation",
        "properties": {
          "flip_triangles": {
            "default": false,
            "description": "Reverse triangle winding order (flip normals)",
            "title": "Flip Triangles",
            "type": "boolean"
          }
        },
        "required": [],
        "title": "CategorySettings",
        "type": "object"
      },
      "source": {
        "additionalProperties": false,
        "description": "Source grid and category attribute",
        "properties": {
          "attribute": {
            "attribute_from": "1/object",
            "attribute_path": {
              "block-model/[>=1.0,<2]": [
                "attributes[?attribute_type=='Boolean'||attribute_type=='Utf8'||attribute_type=='Int8'||attribute_type=='Int16'||attribute_type=='Int32'||attribute_type=='Int64'||attribute_type=='UInt8'||attribute_type=='UInt16'||attribute_type=='UInt32'||attribute_type=='UInt64']"
              ],
              "regular-3d-grid/[>=1.2,<2]": [
                "cell_attributes[?attribute_type=='category']",
                "vertex_attributes[?attribute_type=='category']"
              ],
              "regular-masked-3d-grid/[>=1.2,<2]": [
                "cell_attributes[?attribute_type=='category']"
              ],
              "tensor-3d-grid/[>=1.2,<2]": [
                "cell_attributes[?attribute_type=='category']",
                "vertex_attributes[?attribute_type=='category']"
              ],
              "unstructured-hex-grid/[>=1.2,<2]": [
                "hexahedrons.vertices.attributes[?attribute_type=='category']"
              ],
              "unstructured-tet-grid/[>=1.2,<2]": [
                "tetrahedra.vertices.attributes[?attribute_type=='category']"
              ]
            },
            "description": "Category attribute to generate surface from",
            "reference_to": "attribute",
            "title": "Attribute",
            "type": "string"
          },
          "object": {
            "description": "Input grid containing the category attribute to generate surface from",
            "format": "uri",
            "reference_to": "geoscience-object",
            "supported_schemas": [
              "block-model/[>=1.0,<2]",
              "regular-3d-grid/[>=1.2,<2]",
              "regular-masked-3d-grid/[>=1.2,<2]",
              "tensor-3d-grid/[>=1.2,<2]",
              "unstructured-hex-grid/[>=1.2,<2]",
              "unstructured-tet-grid/[>=1.2,<2]"
            ],
            "title": "Object",
            "type": "string"
          }
        },
        "required": [
          "object",
          "attribute"
        ],
        "title": "CategorySourceInput",
        "type": "object"
      },
      "target": {
        "additionalProperties": false,
        "description": "Where to create the output Triangle Mesh object",
        "properties": {
          "description": {
            "default": null,
            "description": "Description to put into the target object.",
            "title": "Description",
            "type": [
              "string",
              "null"
            ]
          },
          "overwrite": {
            "default": false,
            "description": "Whether to overwrite the existing object.",
            "title": "Overwrite",
            "type": "boolean"
          },
          "reference": {
            "description": "Reference to the targeted object.",
            "format": "uri",
            "reference_to": "geoscience-object",
            "supported_schemas": [
              "triangle-mesh/[>=2.0,<3]"
            ],
            "title": "Reference",
            "type": "string"
          },
          "tags": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Tags to put into the target object.",
            "title": "Tags",
            "type": "object"
          }
        },
        "required": [
          "reference"
        ],
        "target": "geoscience-object",
        "title": "Target",
        "type": "object"
      }
    },
    "required": [
      "source",
      "category",
      "target"
    ],
    "title": "CategoryParameters",
    "type": "object"
  },
  "results": {
    "additionalProperties": false,
    "description": "Results of the isosurfacing task.",
    "properties": {
      "output": {
        "additionalProperties": false,
        "description": "Reference to the created Triangle Mesh object",
        "output": "geoscience-object",
        "properties": {
          "description": {
            "description": "The description of the geoscience object.",
            "title": "Description",
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "description": "The name of the geoscience object.",
            "title": "Name",
            "type": "string"
          },
          "reference": {
            "description": "Reference to a geoscience object.",
            "format": "uri",
            "reference_to": "geoscience-object",
            "supported_schemas": [
              "triangle-mesh/[>=2.0,<3]"
            ],
            "title": "Reference",
            "type": "string"
          },
          "schema_id": {
            "description": "The ID of the Geoscience Object schema.",
            "title": "Schema ID",
            "type": "string"
          }
        },
        "required": [
          "reference",
          "name",
          "description",
          "schema_id"
        ],
        "title": "Output Triangle Mesh",
        "type": "object"
      },
      "summary": {
        "additionalProperties": false,
        "description": "Summary statistics for the generated surface",
        "properties": {
          "has_non_manifold_edges": {
            "description": "Whether the mesh has non-manifold edges (quality check)",
            "title": "Has Non Manifold Edges",
            "type": "boolean"
          },
          "has_unused_vertices": {
            "description": "Whether the mesh has orphan vertices (quality check)",
            "title": "Has Unused Vertices",
            "type": "boolean"
          },
          "is_closed": {
            "description": "Whether the mesh forms a closed volume",
            "title": "Is Closed",
            "type": "boolean"
          },
          "num_triangles": {
            "description": "Number of triangles in the generated surface",
            "title": "Num Triangles",
            "type": "integer"
          },
          "num_vertices": {
            "description": "Number of unique vertices in the mesh",
            "title": "Num Vertices",
            "type": "integer"
          }
        },
        "required": [
          "num_triangles",
          "num_vertices",
          "has_unused_vertices",
          "has_non_manifold_edges",
          "is_closed"
        ],
        "title": "CategorySummary",
        "type": "object"
      }
    },
    "required": [
      "output",
      "summary"
    ],
    "title": "CategoryResults",
    "type": "object"
  }
}
