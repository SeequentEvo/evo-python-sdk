{
  "display_name": "Make GMM Into Intersected Geometry",
  "version": "1.5.16",
  "feature_flag": "geotech-preview",
  "description": "Clips a Geological Model Meshes object and processes it to create an intersected geometry mesh.",
  "parameters": {
    "additionalProperties": false,
    "description": "Parameters for make-gmm-into-intersected-geometry.",
    "properties": {
      "attempt_auto_fix_on_failure": {
        "default": false,
        "description": "Whether to attempt automatic fix on failure.",
        "title": "Attempt Auto Fix On Failure",
        "type": "boolean"
      },
      "attempt_conformalization": {
        "default": false,
        "description": "Whether to attempt conformalization of the intersected geometry.",
        "title": "Attempt Conformalization",
        "type": "boolean"
      },
      "clip_tolerance": {
        "description": "Clip tolerance distance.",
        "exclusiveMinimum": 0,
        "title": "Clip Tolerance",
        "type": "number"
      },
      "collapse_settings": {
        "additionalProperties": false,
        "description": "Settings for collapsing overlapping mesh regions.",
        "examples": [
          {
            "distance_tolerance": 1e-05,
            "overlap_threshold": 0.1
          }
        ],
        "properties": {
          "distance_tolerance": {
            "default": 1e-05,
            "description": "Distance tolerance for collapse, relative to the plane of one of the triangles.",
            "exclusiveMinimum": 0,
            "title": "Distance Tolerance",
            "type": "number"
          },
          "overlap_threshold": {
            "default": 0.1,
            "description": "Overlap threshold fraction.",
            "exclusiveMinimum": 0,
            "maximum": 1,
            "title": "Overlap Threshold",
            "type": "number"
          }
        },
        "required": [],
        "title": "CollapseOverlapsSettings",
        "type": "object"
      },
      "intersection_tolerance_for_auto_fix": {
        "default": 0.001,
        "description": "Intersection tolerance for automatic fix.",
        "exclusiveMinimum": 0,
        "title": "Intersection Tolerance For Auto Fix",
        "type": "number"
      },
      "max_point": {
        "additionalProperties": false,
        "description": "Maximum bounding point to clip to.",
        "examples": [
          {
            "x": 0,
            "y": 0,
            "z": 0
          },
          {
            "x": 100,
            "y": 100,
            "z": 100
          }
        ],
        "properties": {
          "x": {
            "description": "The x coordinate.",
            "title": "X",
            "type": "number"
          },
          "y": {
            "description": "The y coordinate.",
            "title": "Y",
            "type": "number"
          },
          "z": {
            "description": "The z coordinate.",
            "title": "Z",
            "type": "number"
          }
        },
        "required": [
          "x",
          "y",
          "z"
        ],
        "title": "Point3D",
        "type": "object"
      },
      "min_point": {
        "additionalProperties": false,
        "description": "Minimum bounding point to clip to.",
        "examples": [
          {
            "x": 0,
            "y": 0,
            "z": 0
          },
          {
            "x": 100,
            "y": 100,
            "z": 100
          }
        ],
        "properties": {
          "x": {
            "description": "The x coordinate.",
            "title": "X",
            "type": "number"
          },
          "y": {
            "description": "The y coordinate.",
            "title": "Y",
            "type": "number"
          },
          "z": {
            "description": "The z coordinate.",
            "title": "Z",
            "type": "number"
          }
        },
        "required": [
          "x",
          "y",
          "z"
        ],
        "title": "Point3D",
        "type": "object"
      },
      "remesh_settings": {
        "additionalProperties": false,
        "description": "Settings for remeshing during automatic fix.",
        "examples": [
          {
            "initial_cleanup": true,
            "is_closed": false,
            "line_proximity_detection": false,
            "max_chordal_error": -0.005,
            "optimize": true,
            "patch_angle_tolerance": 10,
            "regularize_mode": false,
            "relax_chunk_interfaces": false,
            "shape_quality_weight": 0.6,
            "strain_tolerance": 0.3,
            "target_h": 0
          }
        ],
        "properties": {
          "initial_cleanup": {
            "default": true,
            "description": "Whether to run initial cleanup such as node merging, gap filling, and topological fixing.",
            "title": "Initial Cleanup",
            "type": "boolean"
          },
          "is_closed": {
            "default": false,
            "description": "Whether the mesh is closed; should be true for manifold GMVs.",
            "title": "Is Closed",
            "type": "boolean"
          },
          "line_proximity_detection": {
            "default": false,
            "description": "Whether to consider distance between skeleton lines when sizing elements.",
            "title": "Line Proximity Detection",
            "type": "boolean"
          },
          "max_chordal_error": {
            "default": -0.005,
            "description": "Maximum relative local error. -0.005 corresponds to 0.5%.",
            "title": "Max Chordal Error",
            "type": "number"
          },
          "optimize": {
            "default": true,
            "description": "Whether to perform final optimization.",
            "title": "Optimize",
            "type": "boolean"
          },
          "patch_angle_tolerance": {
            "default": 10,
            "description": "Angle change in degrees used to define a patch skeleton line.",
            "exclusiveMinimum": 0,
            "title": "Patch Angle Tolerance",
            "type": "number"
          },
          "regularize_mode": {
            "default": false,
            "description": "If true, do not remesh; only regularize the mesh.",
            "title": "Regularize Mode",
            "type": "boolean"
          },
          "relax_chunk_interfaces": {
            "default": false,
            "description": "Whether to relax chunk interfaces during remeshing.",
            "title": "Relax Chunk Interfaces",
            "type": "boolean"
          },
          "shape_quality_weight": {
            "default": 0.6,
            "description": "Size-versus-shape weight from 0 to 1.",
            "minimum": 0,
            "title": "Shape Quality Weight",
            "type": "number"
          },
          "strain_tolerance": {
            "default": 0.3,
            "description": "Relative quality difference before and after unfolding to a plane.",
            "minimum": 0,
            "title": "Strain Tolerance",
            "type": "number"
          },
          "target_h": {
            "default": 0,
            "description": "Target element size. Zero bases the size on skeleton lines.",
            "minimum": 0,
            "title": "Target Edge Length",
            "type": "number"
          }
        },
        "required": [],
        "title": "RemeshSettings",
        "type": "object"
      },
      "rotation_angle": {
        "default": 0,
        "description": "Rotation angle around the bounds center.",
        "title": "Rotation Angle",
        "type": "number"
      },
