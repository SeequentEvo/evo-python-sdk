{
  "display_name": "Add To Intersected Geometry",
  "version": "1.5.16",
  "feature_flag": "geotech-preview",
  "description": "Adds one or more triangle mesh objects to an existing intersected Geological Model Meshes object.",
  "parameters": {
    "additionalProperties": false,
    "description": "Parameters for add-to-intersected-geometry.",
    "properties": {
      "max_point": {
        "additionalProperties": false,
        "description": "Maximum bounding point to clip to.",
        "examples": [
          {
            "x": 0,
            "y": 0,
            "z": 0
          },
          {
            "x": 100,
            "y": 100,
            "z": 100
          }
        ],
        "properties": {
          "x": {
            "description": "The x coordinate.",
            "title": "X",
            "type": "number"
          },
          "y": {
            "description": "The y coordinate.",
            "title": "Y",
            "type": "number"
          },
          "z": {
            "description": "The z coordinate.",
            "title": "Z",
            "type": "number"
          }
        },
        "required": [
          "x",
          "y",
          "z"
        ],
        "title": "Point3D",
        "type": "object"
      },
      "meshes_to_add": {
        "description": "List of triangle mesh objects to add to the intersected geometry.",
        "examples": [
          [
            "/geoscience-object/orgs/00000000-0000-0000-0000-000000000000/workspaces/11111111-1111-1111-1111-111111111111/objects/mesh1.json"
          ]
        ],
        "items": {
          "description": "A triangle mesh object to add to the intersected geometry.",
          "format": "uri",
          "reference_to": "geoscience-object",
          "supported_schemas": [
            "triangle-mesh/[>=2.0,<3]"
          ],
          "title": "Triangle Mesh",
          "type": "string"
        },
        "minItems": 1,
        "title": "Meshes To Add",
        "type": "array"
      },
      "min_point": {
        "additionalProperties": false,
        "description": "Minimum bounding point to clip to.",
        "examples": [
          {
            "x": 0,
            "y": 0,
            "z": 0
          },
          {
            "x": 100,
            "y": 100,
            "z": 100
          }
        ],
        "properties": {
          "x": {
            "description": "The x coordinate.",
            "title": "X",
            "type": "number"
          },
          "y": {
            "description": "The y coordinate.",
            "title": "Y",
            "type": "number"
          },
          "z": {
            "description": "The z coordinate.",
            "title": "Z",
            "type": "number"
          }
        },
        "required": [
          "x",
          "y",
          "z"
        ],
        "title": "Point3D",
        "type": "object"
      },
      "rotation_angle": {
        "default": 0,
        "description": "Rotation angle around the bounds center.",
        "title": "Rotation Angle",
        "type": "number"
      },
      "source": {
        "description": "The existing intersected geometry (Geological Model Meshes) to add meshes to.",
        "format": "uri",
        "reference_to": "geoscience-object",
        "supported_schemas": [
          "geological-model-meshes/[>=2.0,<3]"
        ],
        "title": "Geological Model Meshes",
        "type": "string"
      },
      "target": {
        "additionalProperties": false,
        "description": "Target specifying where to create the new Geological Model Meshes object. Provide an object with a reference field containing a path-based geoscience object URL and an overwrite field containing a boolean value. Only path-based object references can be used for creating a new object.",
        "examples": [
          {
            "overwrite": false,
            "reference": "https://example.api.seequent.com/geoscience-object/orgs/00000000-0000-0000-0000-000000000000/workspaces/11111111-1111-1111-1111-111111111111/objects/path/results/output.json"
          }
        ],
        "properties": {
          "description": {
            "default": null,
            "description": "Description to put into the target object.",
            "title": "Description",
            "type": [
              "string",
              "null"
            ]
          },
          "overwrite": {
            "default": false,
            "description": "Whether to overwrite the existing object.",
            "title": "Overwrite",
            "type": "boolean"
          },
          "reference": {
            "description": "Reference to the targeted object.",
            "format": "uri",
            "reference_to": "geoscience-object",
            "supported_schemas": [
              "geological-model-meshes/[>=2.0,<3]"
            ],
            "title": "Reference",
            "type": "string"
          },
          "tags": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Tags to put into the target object.",
            "title": "Tags",
            "type": "object"
          }
        },
        "required": [
          "reference"
        ],
        "target": "geoscience-object",
        "title": "Target",
        "type": "object"
      },
      "tolerance": {
        "description": "Tolerance distance for the intersection operation.",
        "exclusiveMinimum": 0,
        "title": "Tolerance",
        "type": "number"
      }
    },
    "required": [
      "source",
      "meshes_to_add",
      "target",
      "tolerance"
    ],
    "title": "AddToIntersectedGeometryParameters",
    "type": "object"
  },
  "results": {
    "additionalProperties": false,
    "description": "Results of add-to-intersected-geometry.",
    "properties": {
      "message": {
        "description": "Description of the result of the operation.",
        "examples": [
          "Successfully added meshes to intersected geometry."
        ],
        "title": "Message",
        "type": "string"
      },
      "object": {
        "additionalProperties": false,
        "description": "The new Geological Model Meshes object with added meshes.",
        "examples": [
          {
            "description": "Geological model meshes",
            "name": "output.json",
            "reference": "https://example.api.seequent.com/geoscience-object/orgs/00000000-0000-0000-0000-000000000000/workspaces/11111111-1111-1111-1111-111111111111/objects/path/results/output.json",
            "schema_id": "geological-model-meshes/2.0.0"
          }
        ],
        "output": "geoscience-object",
        "properties": {
          "description": {
            "description": "The description of the geoscience object.",
            "title": "Description",
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "description": "The name of the geoscience object.",
            "title": "Name",
            "type": "string"
          },
          "reference": {
            "description": "Reference to a geoscience object.",
            "format": "uri",
            "reference_to": "geoscience-object",
            "supported_schemas": [
              "geological-model-meshes/[>=2.0,<3]"
            ],
            "title": "Reference",
            "type": "string"
          },
          "schema_id": {
            "description": "The ID of the Geoscience Object schema.",
            "title": "Schema ID",
            "type": "string"
          }
        },
        "required": [
          "reference",
          "name",
          "description",
          "schema_id"
        ],
        "title": "Geological Model Meshes",
        "type": "object"
      }
    },
    "required": [
      "object",
      "message"
    ],
    "title": "AddToIntersectedGeometryResults",
    "type": "object"
  }
}
