{
  "display_name": "Init Aggregate Geom GMM",
  "version": "1.5.16",
  "feature_flag": "geotech-preview",
  "description": "Creates a rotated bounding box as a Geological Model Meshes object, used as the initial intersected geometry when creating a model.",
  "parameters": {
    "additionalProperties": false,
    "description": "Parameters for init-aggregate-geom-gmm.",
    "properties": {
      "coordinate_reference_system": {
        "default": null,
        "description": "The coordinate reference system that the other parameters are defined in. Specified as either an EPSG code string (e.g., 'EPSG:32611') or a WKT2 coordinate reference system definition string. If not provided, the CRS will be marked as unspecified.",
        "title": "Coordinate Reference System",
        "type": [
          "string",
          "null"
        ]
      },
      "max_point": {
        "additionalProperties": false,
        "description": "The maximum corner of the bounding box.",
        "examples": [
          {
            "x": 0,
            "y": 0,
            "z": 0
          },
          {
            "x": 100,
            "y": 100,
            "z": 100
          }
        ],
        "properties": {
          "x": {
            "description": "The x coordinate.",
            "title": "X",
            "type": "number"
          },
          "y": {
            "description": "The y coordinate.",
            "title": "Y",
            "type": "number"
          },
          "z": {
            "description": "The z coordinate.",
            "title": "Z",
            "type": "number"
          }
        },
        "required": [
          "x",
          "y",
          "z"
        ],
        "title": "Point3D",
        "type": "object"
      },
      "min_point": {
        "additionalProperties": false,
        "description": "The minimum corner of the bounding box.",
        "examples": [
          {
            "x": 0,
            "y": 0,
            "z": 0
          },
          {
            "x": 100,
            "y": 100,
            "z": 100
          }
        ],
        "properties": {
          "x": {
            "description": "The x coordinate.",
            "title": "X",
            "type": "number"
          },
          "y": {
            "description": "The y coordinate.",
            "title": "Y",
            "type": "number"
          },
          "z": {
            "description": "The z coordinate.",
            "title": "Z",
            "type": "number"
          }
        },
        "required": [
          "x",
          "y",
          "z"
        ],
        "title": "Point3D",
        "type": "object"
      },
      "rotation_angle": {
        "default": 0,
        "description": "The rotation angle for the bounding box, in radians.",
        "title": "Rotation Angle",
        "type": "number"
      },
      "target": {
        "additionalProperties": false,
        "description": "Target specifying where to create the new Geological Model Meshes object. Provide an object with a reference field containing a path-based geoscience object URL and an overwrite field containing a boolean value. Only path-based object references can be used for creating a new object.",
        "examples": [
          {
            "overwrite": false,
            "reference": "https://example.api.seequent.com/geoscience-object/orgs/00000000-0000-0000-0000-000000000000/workspaces/11111111-1111-1111-1111-111111111111/objects/path/results/output.json"
          }
        ],
        "properties": {
          "description": {
            "default": null,
            "description": "Description to put into the target object.",
            "title": "Description",
            "type": [
              "string",
              "null"
            ]
          },
          "overwrite": {
            "default": false,
            "description": "Whether to overwrite the existing object.",
            "title": "Overwrite",
            "type": "boolean"
          },
          "reference": {
            "description": "Reference to the targeted object.",
            "format": "uri",
            "reference_to": "geoscience-object",
            "supported_schemas": [
              "geological-model-meshes/[>=2.0,<3]"
            ],
            "title": "Reference",
            "type": "string"
          },
          "tags": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Tags to put into the target object.",
            "title": "Tags",
            "type": "object"
          }
        },
        "required": [
          "reference"
        ],
        "target": "geoscience-object",
        "title": "Target",
        "type": "object"
      }
    },
    "required": [
      "target",
      "min_point",
      "max_point"
    ],
    "title": "InitAggregateGeomGmmParameters",
    "type": "object"
  },
