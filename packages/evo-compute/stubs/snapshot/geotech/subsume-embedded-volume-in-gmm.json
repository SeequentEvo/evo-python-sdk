{
  "display_name": "Subsume Embedded Volume in GMM",
  "version": "1.5.16",
  "feature_flag": "geotech-preview",
  "description": "Merges a specified source embedded volume into a target volume in a GMM, either by explicit index or by automatic selection strategy.",
  "parameters": {
    "additionalProperties": false,
    "description": "Parameters for subsume-embedded-volume-in-gmm.",
    "properties": {
      "source": {
        "description": "The Geological Model Meshes object to process.",
        "format": "uri",
        "reference_to": "geoscience-object",
        "supported_schemas": [
          "geological-model-meshes/[>=2.0,<3]"
        ],
        "title": "Geological Model Meshes",
        "type": "string"
      },
      "subsume_source": {
        "description": "The index of the embedded volume to subsume (source).",
        "minimum": 0,
        "title": "Subsume Source",
        "type": "integer"
      },
      "target": {
        "additionalProperties": false,
        "description": "Target specifying where to create the new Geological Model Meshes object. Provide an object with a reference field containing a path-based geoscience object URL and an overwrite field containing a boolean value. Only path-based object references can be used for creating a new object.",
        "examples": [
          {
            "overwrite": false,
            "reference": "https://example.api.seequent.com/geoscience-object/orgs/00000000-0000-0000-0000-000000000000/workspaces/11111111-1111-1111-1111-111111111111/objects/path/results/output.json"
          }
        ],
        "properties": {
          "description": {
            "default": null,
            "description": "Description to put into the target object.",
            "title": "Description",
            "type": [
              "string",
              "null"
            ]
          },
          "overwrite": {
            "default": false,
            "description": "Whether to overwrite the existing object.",
            "title": "Overwrite",
            "type": "boolean"
          },
          "reference": {
            "description": "Reference to the targeted object.",
            "format": "uri",
            "reference_to": "geoscience-object",
            "supported_schemas": [
              "geological-model-meshes/[>=2.0,<3]"
            ],
            "title": "Reference",
            "type": "string"
          },
          "tags": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Tags to put into the target object.",
            "title": "Tags",
            "type": "object"
          }
        },
        "required": [
          "reference"
        ],
        "target": "geoscience-object",
        "title": "Target",
        "type": "object"
      },
      "target_selection": {
        "description": "Target volume selection. Either an explicit volume index or an automatic selection strategy.",
        "discriminator": "selection_mode",
        "oneOf": [
          {
            "additionalProperties": false,
            "description": "Select the target volume by its explicit index.",
            "properties": {
              "selection_mode": {
                "const": "Explicit",
                "description": "Explicit target selection mode.",
                "title": "Selection Mode"
              },
              "volume_index": {
                "description": "The index of the target volume.",
                "minimum": 0,
                "title": "Volume Index",
                "type": "integer"
              }
            },
            "required": [
              "selection_mode",
              "volume_index"
            ],
            "title": "ExplicitTargetSelection",
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "Automatically select the neighbouring volume with the largest volume.",
            "properties": {
              "selection_mode": {
                "const": "LargestNeighbouringVolume",
                "description": "Largest neighbouring volume selection mode.",
                "title": "Selection Mode"
              }
            },
            "required": [
              "selection_mode"
            ],
            "title": "LargestNeighbouringVolumeTargetSelection",
            "type": "object"
          },
          {
            "additionalProperties": false,
            "description": "Automatically select the neighbouring volume with the largest shared contact area.",
            "properties": {
              "selection_mode": {
                "const": "LargestNeighbouringContactArea",
                "description": "Largest neighbouring contact area selection mode.",
                "title": "Selection Mode"
              }
            },
            "required": [
              "selection_mode"
            ],
            "title": "LargestNeighbouringContactAreaTargetSelection",
            "type": "object"
          }
        ],
        "title": "Target Selection"
      }
    },
    "required": [
      "source",
      "target",
      "subsume_source",
      "target_selection"
    ],
    "title": "SubsumeEmbeddedVolumeInGmmParameters",
    "type": "object"
  },
  "results": {
    "additionalProperties": false,
    "description": "Results of subsume-embedded-volume-in-gmm.",
    "properties": {
      "message": {
        "description": "Description of the result of the operation.",
        "examples": [
          "Successfully subsumed embedded volume."
        ],
        "title": "Message",
        "type": "string"
      },
      "object": {
        "additionalProperties": false,
        "description": "The new Geological Model Meshes object with the volume subsumed.",
        "examples": [
          {
            "description": "Geological model meshes",
            "name": "output.json",
            "reference": "https://example.api.seequent.com/geoscience-object/orgs/00000000-0000-0000-0000-000000000000/workspaces/11111111-1111-1111-1111-111111111111/objects/path/results/output.json",
            "schema_id": "geological-model-meshes/2.0.0"
          }
        ],
        "output": "geoscience-object",
        "properties": {
          "description": {
            "description": "The description of the geoscience object.",
            "title": "Description",
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "description": "The name of the geoscience object.",
            "title": "Name",
            "type": "string"
          },
          "reference": {
            "description": "Reference to a geoscience object.",
            "format": "uri",
            "reference_to": "geoscience-object",
            "supported_schemas": [
              "geological-model-meshes/[>=2.0,<3]"
            ],
            "title": "Reference",
            "type": "string"
          },
          "schema_id": {
            "description": "The ID of the Geoscience Object schema.",
            "title": "Schema ID",
            "type": "string"
          }
        },
        "required": [
          "reference",
          "name",
          "description",
          "schema_id"
        ],
        "title": "Geological Model Meshes",
        "type": "object"
      }
    },
    "required": [
      "object",
      "message"
    ],
    "title": "SubsumeEmbeddedVolumeInGmmResults",
    "type": "object"
  }
}
