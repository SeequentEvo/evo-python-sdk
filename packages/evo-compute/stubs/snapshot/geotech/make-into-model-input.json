{
  "display_name": "Make Into Model Input",
  "version": "1.5.16",
  "feature_flag": "geotech-preview",
  "description": "Clips a triangle mesh loosely to the specified bounds, merges duplicate points, and translates the result so it can be used as model input.",
  "parameters": {
    "additionalProperties": false,
    "description": "Parameters for make-into-model-input.",
    "properties": {
      "max_point": {
        "additionalProperties": false,
        "description": "Maximum bounding point to clip the triangle mesh to.",
        "examples": [
          {
            "x": 0,
            "y": 0,
            "z": 0
          },
          {
            "x": 100,
            "y": 100,
            "z": 100
          }
        ],
        "properties": {
          "x": {
            "description": "The x coordinate.",
            "title": "X",
            "type": "number"
          },
          "y": {
            "description": "The y coordinate.",
            "title": "Y",
            "type": "number"
          },
          "z": {
            "description": "The z coordinate.",
            "title": "Z",
            "type": "number"
          }
        },
        "required": [
          "x",
          "y",
          "z"
        ],
        "title": "Maximum Point",
        "type": "object"
      },
      "min_point": {
        "additionalProperties": false,
        "description": "Minimum bounding point to clip the triangle mesh to.",
        "examples": [
          {
            "x": 0,
            "y": 0,
            "z": 0
          },
          {
            "x": 100,
            "y": 100,
            "z": 100
          }
        ],
        "properties": {
          "x": {
            "description": "The x coordinate.",
            "title": "X",
            "type": "number"
          },
          "y": {
            "description": "The y coordinate.",
            "title": "Y",
            "type": "number"
          },
          "z": {
            "description": "The z coordinate.",
            "title": "Z",
            "type": "number"
          }
        },
        "required": [
          "x",
          "y",
          "z"
        ],
        "title": "Minimum Point",
        "type": "object"
      },
      "rotation_angle": {
        "default": 0,
        "description": "Rotation angle, in radians, used when evaluating the clipping bounds.",
        "title": "Rotation Angle",
        "type": "number"
      },
      "source": {
        "description": "The triangle mesh object to prepare for use in a model.",
        "format": "uri",
        "reference_to": "geoscience-object",
        "supported_schemas": [
          "triangle-mesh/[>=2.0,<3]"
        ],
        "title": "Triangle Mesh",
        "type": "string"
      },
      "target": {
        "additionalProperties": false,
        "description": "Target specifying where to create the new Triangle Mesh object. Provide an object with a reference field containing a path-based geoscience object URL and an overwrite field containing a boolean value. Only path-based object references can be used for creating a new object.",
        "examples": [
          {
            "overwrite": false,
            "reference": "https://example.api.seequent.com/geoscience-object/orgs/00000000-0000-0000-0000-000000000000/workspaces/11111111-1111-1111-1111-111111111111/objects/path/results/output.json"
          }
        ],
        "properties": {
          "description": {
            "default": null,
            "description": "Description to put into the target object.",
            "title": "Description",
            "type": [
              "string",
              "null"
            ]
          },
          "overwrite": {
            "default": false,
            "description": "Whether to overwrite the existing object.",
            "title": "Overwrite",
            "type": "boolean"
          },
          "reference": {
            "description": "Reference to the targeted object.",
            "format": "uri",
            "reference_to": "geoscience-object",
            "supported_schemas": [
              "triangle-mesh/[>=2.0,<3]"
            ],
            "title": "Reference",
            "type": "string"
          },
          "tags": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Tags to put into the target object.",
            "title": "Tags",
            "type": "object"
          }
        },
        "required": [
          "reference"
        ],
        "target": "geoscience-object",
        "title": "Target",
        "type": "object"
      },
      "tolerance": {
        "default": 1e-12,
        "description": "Tolerance used when clipping the mesh and merging duplicate points.",
        "exclusiveMinimum": 0,
        "title": "Tolerance",
        "type": "number"
      }
    },
    "required": [
      "source",
      "target"
    ],
    "title": "MakeIntoModelInputParameters",
    "type": "object"
  },
  "results": {
    "additionalProperties": false,
    "description": "Results for make-into-model-input.",
    "properties": {
      "message": {
        "description": "Description of the result of the operation.",
        "examples": [
          "Successfully prepared the triangle mesh for model input."
        ],
        "title": "Message",
        "type": "string"
      },
      "object": {
        "additionalProperties": false,
        "description": "The prepared Triangle Mesh object.",
        "examples": [
          {
            "description": "The prepared Triangle Mesh object.",
            "name": "output.json",
            "reference": "https://example.api.seequent.com/geoscience-object/orgs/00000000-0000-0000-0000-000000000000/workspaces/11111111-1111-1111-1111-111111111111/objects/path/results/output.json",
            "schema_id": "triangle-mesh/2.0.0"
          }
        ],
        "output": "geoscience-object",
        "properties": {
          "description": {
            "description": "The description of the geoscience object.",
            "title": "Description",
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "description": "The name of the geoscience object.",
            "title": "Name",
            "type": "string"
          },
          "reference": {
            "description": "Reference to a geoscience object.",
            "format": "uri",
            "reference_to": "geoscience-object",
            "supported_schemas": [
              "triangle-mesh/[>=2.0,<3]"
            ],
            "title": "Reference",
            "type": "string"
          },
          "schema_id": {
            "description": "The ID of the Geoscience Object schema.",
            "title": "Schema ID",
            "type": "string"
          }
        },
        "required": [
          "reference",
          "name",
          "description",
          "schema_id"
        ],
        "title": "Triangle Mesh",
        "type": "object"
      }
    },
    "required": [
      "object",
      "message"
    ],
    "title": "MakeIntoModelInputResults",
    "type": "object"
  }
}
