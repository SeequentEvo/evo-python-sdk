{
  "display_name": "Remove Triangles",
  "version": "1.5.16",
  "feature_flag": "geotech-preview",
  "description": "Removes the selected triangle indices from a Geological Model Meshes object and uploads the updated mesh as a new object.",
  "parameters": {
    "additionalProperties": false,
    "description": "Parameters for remove-triangles.",
    "properties": {
      "source": {
        "description": "The mesh to process. Supports Triangle Mesh and Geological Model Meshes.",
        "format": "uri",
        "reference_to": "geoscience-object",
        "supported_schemas": [
          "triangle-mesh/[>=2.0,<3]",
          "geological-model-meshes/[>=2.0,<3]"
        ],
        "title": "Input Mesh",
        "type": "string"
      },
      "target": {
        "additionalProperties": false,
        "description": "Target specifying where to create the output mesh object. Provide an object with a reference field containing a path-based geoscience object URL and an overwrite field containing a boolean value.",
        "examples": [
          {
            "overwrite": false,
            "reference": "https://example.api.seequent.com/geoscience-object/orgs/00000000-0000-0000-0000-000000000000/workspaces/11111111-1111-1111-1111-111111111111/objects/path/results/output.json"
          }
        ],
        "properties": {
          "description": {
            "default": null,
            "description": "Description to put into the target object.",
            "title": "Description",
            "type": [
              "string",
              "null"
            ]
          },
          "overwrite": {
            "default": false,
            "description": "Whether to overwrite the existing object.",
            "title": "Overwrite",
            "type": "boolean"
          },
          "reference": {
            "description": "Reference to the targeted object.",
            "format": "uri",
            "reference_to": "geoscience-object",
            "supported_schemas": [
              "triangle-mesh/[>=2.0,<3]",
              "geological-model-meshes/[>=2.0,<3]"
            ],
            "title": "Reference",
            "type": "string"
          },
          "tags": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Tags to put into the target object.",
            "title": "Tags",
            "type": "object"
          }
        },
        "required": [
          "reference"
        ],
        "target": "geoscience-object",
        "title": "Target",
        "type": "object"
      },
      "triangle_indices": {
        "description": "Indices of triangles to remove from the mesh.",
        "items": {
          "description": "The index of a triangle to remove from the mesh.",
          "minimum": 0,
          "title": "Triangle Index",
          "type": "integer"
        },
        "minItems": 1,
        "title": "Triangle Indices",
        "type": "array"
      }
    },
    "required": [
      "source",
      "target",
      "triangle_indices"
    ],
    "title": "RemoveTrianglesParameters",
    "type": "object"
  },
  "results": {
    "additionalProperties": false,
    "description": "Results of remove-triangles.",
    "properties": {
      "message": {
        "description": "Description of the result of the operation.",
        "examples": [
          "Successfully removed selected triangles from the mesh."
        ],
        "title": "Message",
        "type": "string"
      },
      "object": {
        "additionalProperties": false,
        "description": "The new mesh object with the selected triangles removed.",
        "examples": [
          {
            "description": "The new mesh object with the selected triangles removed.",
            "name": "output.json",
            "reference": "https://example.api.seequent.com/geoscience-object/orgs/00000000-0000-0000-0000-000000000000/workspaces/11111111-1111-1111-1111-111111111111/objects/path/results/output.json",
            "schema_id": "triangle-mesh/2.0.0"
          }
        ],
        "output": "geoscience-object",
        "properties": {
          "description": {
            "description": "The description of the geoscience object.",
            "title": "Description",
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "description": "The name of the geoscience object.",
            "title": "Name",
            "type": "string"
          },
          "reference": {
            "description": "Reference to a geoscience object.",
            "format": "uri",
            "reference_to": "geoscience-object",
            "supported_schemas": [
              "triangle-mesh/[>=2.0,<3]",
              "geological-model-meshes/[>=2.0,<3]"
            ],
            "title": "Reference",
            "type": "string"
          },
          "schema_id": {
            "description": "The ID of the Geoscience Object schema.",
            "title": "Schema ID",
            "type": "string"
          }
        },
        "required": [
          "reference",
          "name",
          "description",
          "schema_id"
        ],
        "title": "Output Mesh",
        "type": "object"
      }
    },
    "required": [
      "object",
      "message"
    ],
    "title": "RemoveTrianglesResults",
    "type": "object"
  }
}
