{
  "display_name": "Create Cross Section",
  "version": "1.5.16",
  "feature_flag": "geotech-preview",
  "description": "Intersects parametric volumes in a 3D Design Geometry with a vertical plane defined by a section origin and dip azimuth, producing a 2D Design Geometry with polyline boundaries.",
  "parameters": {
    "additionalProperties": false,
    "description": "Parameters for create-cross-section.",
    "properties": {
      "section_dip_azimuth_degrees": {
        "description": "Azimuth angle in degrees for the cross-section plane.",
        "exclusiveMaximum": 360,
        "minimum": 0,
        "title": "Section Dip Azimuth Degrees",
        "type": "number"
      },
      "section_origin": {
        "additionalProperties": false,
        "description": "Origin point of the cross-section plane.",
        "examples": [
          {
            "x": 0,
            "y": 0,
            "z": 0
          },
          {
            "x": 100,
            "y": 100,
            "z": 100
          }
        ],
        "properties": {
          "x": {
            "description": "The x coordinate.",
            "title": "X",
            "type": "number"
          },
          "y": {
            "description": "The y coordinate.",
            "title": "Y",
            "type": "number"
          },
          "z": {
            "description": "The z coordinate.",
            "title": "Z",
            "type": "number"
          }
        },
        "required": [
          "x",
          "y",
          "z"
        ],
        "title": "Point3D",
        "type": "object"
      },
      "source": {
        "description": "The input 3D Design Geometry (Domain3D) containing parameterized volumes. Supports Design Geometry schema version 1.1+.",
        "format": "uri",
        "reference_to": "geoscience-object",
        "supported_schemas": [
          "design-geometry/[>=1.0,<2]"
        ],
        "title": "Input Design Geometry",
        "type": "string"
      },
      "target": {
        "additionalProperties": false,
        "description": "Target specifying where to create the 2D cross-section Design Geometry result. Provide an object with a reference field containing a path-based geoscience object URL and an overwrite field containing a boolean value.",
        "examples": [
          {
            "overwrite": false,
            "reference": "https://example.api.seequent.com/geoscience-object/orgs/00000000-0000-0000-0000-000000000000/workspaces/11111111-1111-1111-1111-111111111111/objects/path/results/output.json"
          }
        ],
        "properties": {
          "description": {
            "default": null,
            "description": "Description to put into the target object.",
            "title": "Description",
            "type": [
              "string",
              "null"
            ]
          },
          "overwrite": {
            "default": false,
            "description": "Whether to overwrite the existing object.",
            "title": "Overwrite",
            "type": "boolean"
          },
          "reference": {
            "description": "Reference to the targeted object.",
            "format": "uri",
            "reference_to": "geoscience-object",
            "supported_schemas": [
              "design-geometry/[>=1.0,<2]"
            ],
            "title": "Reference",
            "type": "string"
          },
          "tags": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Tags to put into the target object.",
            "title": "Tags",
            "type": "object"
          }
        },
        "required": [
          "reference"
        ],
        "target": "geoscience-object",
        "title": "Target",
        "type": "object"
      }
    },
    "required": [
      "source",
      "target",
      "section_origin",
      "section_dip_azimuth_degrees"
    ],
    "title": "CreateCrossSectionParameters",
    "type": "object"
  },
  "results": {
    "additionalProperties": false,
    "description": "Results for create-cross-section.",
    "properties": {
      "message": {
        "description": "Summary of the task outcome.",
        "examples": [
          "Successfully created cross section."
        ],
        "title": "Message",
        "type": "string"
      },
      "object": {
        "additionalProperties": false,
        "description": "The 2D cross-section design geometry output.",
        "examples": [
          {
            "description": "The 2D cross-section design geometry output.",
            "name": "output.json",
            "reference": "https://example.api.seequent.com/geoscience-object/orgs/00000000-0000-0000-0000-000000000000/workspaces/11111111-1111-1111-1111-111111111111/objects/path/results/output.json",
            "schema_id": "design-geometry/1.1.0"
          }
        ],
        "output": "geoscience-object",
        "properties": {
          "description": {
            "description": "The description of the geoscience object.",
            "title": "Description",
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "description": "The name of the geoscience object.",
            "title": "Name",
            "type": "string"
          },
          "reference": {
            "description": "Reference to a geoscience object.",
            "format": "uri",
            "reference_to": "geoscience-object",
            "supported_schemas": [
              "design-geometry/[>=1.0,<2]"
            ],
            "title": "Reference",
            "type": "string"
          },
          "schema_id": {
            "description": "The ID of the Geoscience Object schema.",
            "title": "Schema ID",
            "type": "string"
          }
        },
        "required": [
          "reference",
          "name",
          "description",
          "schema_id"
        ],
        "title": "Cross Section Design Geometry",
        "type": "object"
      }
    },
    "required": [
      "object",
      "message"
    ],
    "title": "CreateCrossSectionResults",
    "type": "object"
  }
}
